@model IReadOnlyList<WikiScrapper.Domain.Dtos.VoivodeshipDto>
@{
    ViewData["Title"] = Localizer["Voivodeships.Title"].Value;
    var langName = WikiLanguageExtensions.ToDisplayName(WikiLang.Current);
}

<h1 class="mb-2">@Localizer["Voivodeships.Title"]</h1>
<p class="text-muted mb-4">@Localizer["Voivodeships.Intro", langName]</p>

<div class="row g-3">
    @foreach (var voivodeship in Model)
    {
        var fetched = voivodeship.Description is not null;
        <div class="col-md-6 col-xl-4">
            @if (fetched)
            {
                <div class="card voivodeship-card" role="button" tabindex="0"
                     data-bs-toggle="modal" data-bs-target="#voivodeship-modal-@voivodeship.Id">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 mb-0">@voivodeship.Name</h2>
                            <span class="badge text-bg-success">@Localizer["Common.Fetched"]</span>
                        </div>
                        <p class="card-text mb-2">
                            @(voivodeship.Description!.Length > 160 ? voivodeship.Description[..160] + "…" : voivodeship.Description)
                        </p>
                        <small class="text-muted">
                            @voivodeship.FetchedAt!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </small>
                    </div>
                </div>
            }
            else
            {
                <div class="card voivodeship-card is-empty">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 mb-0">@voivodeship.Name</h2>
                            <span class="badge text-bg-secondary">@Localizer["Common.NotFetched"]</span>
                        </div>
                        <p class="card-text text-muted mb-0">
                            @Localizer["Voivodeships.NotFetchedYet", langName]
                            <a asp-controller="Home" asp-action="Index">@Localizer["Voivodeships.RunSync"]</a>
                            @Localizer["Voivodeships.RunSyncHint"]
                        </p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@foreach (var voivodeship in Model.Where(v => v.Description is not null))
{
    var fetchedLabel = voivodeship.FetchedAt!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    <div class="modal fade" id="voivodeship-modal-@voivodeship.Id" tabindex="-1"
         aria-labelledby="voivodeship-modal-label-@voivodeship.Id" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="voivodeship-modal-label-@voivodeship.Id">@voivodeship.Name</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Common.Close"]"></button>
                </div>
                <div class="modal-body">
                    <p>@voivodeship.Description</p>
                </div>
                <div class="modal-footer justify-content-between">
                    <small class="text-muted">
                        @Localizer["Voivodeships.FetchedAt", fetchedLabel]
                    </small>
                    @if (voivodeship.WikiUrl is not null)
                    {
                        <a href="@voivodeship.WikiUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                            @Localizer["Common.OpenOnWikipedia"]
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}
